# Install as /etc/dar-tahara/backup.env owned by root with mode 0600.
# Restic encrypts all repository data with the password in this separate file.
RESTIC_REPOSITORY=s3:https://s3.example.invalid/dar-tahara-production-backups
RESTIC_PASSWORD_FILE=/etc/dar-tahara/restic-password
# Confirm this bind-mount path against the deployed Compose file. The backup
# fails rather than silently omitting object payloads when it is wrong.
SUPABASE_STORAGE_PATH=/srv/dartahara/supabase/volumes/storage

# S3-compatible repository credentials. Use a dedicated identity restricted to
# this backup bucket; do not reuse application object-storage credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# HTTPS endpoint for the owned operations/on-call channel. The URL is a secret.
BACKUP_ALERT_WEBHOOK_URL=

BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
