# Dar Tahara environment configuration
# Copy to .env.local. Never expose server secrets with NEXT_PUBLIC_ names.

NODE_ENV=production
APP_BASE_URL=https://www.dartahara.com
LOG_LEVEL=info

NEXT_PUBLIC_SITE_URL=https://www.dartahara.com

# Optional ownership verification. Values are public meta-tag tokens, not secrets.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privileged roles require Supabase AAL2 by default in production. Set false
# only under the documented, time-boxed break-glass procedure.
REQUIRE_PRIVILEGED_AAL2=true
TRUSTED_PROXY_HOPS=1
# Generate independently (for example: openssl rand -hex 32). Used only to
# HMAC rate-limit keys before shared counters are stored.
RATE_LIMIT_KEY_SECRET=
# Owned incident/on-call endpoint. Treat the URL as a secret. High/critical
# structured application security events are POSTed here.
SECURITY_ALERT_WEBHOOK_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Reveal a provider button only after that provider is enabled and verified in
# the matching Supabase environment. Both remain hidden by default.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Admin and customer authentication use Supabase Auth. Keep email confirmation
# enabled and configure Google/Apple in Supabase; see docs/CUSTOMER_PLATFORM.md.
# These are consumed only by the local Supabase CLI when social providers are enabled.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Stripe. Merchant of record: Paradox FZCO (Dubai, UAE).
# Use test keys (sk_test_… / pk_test_…) in dev & staging, live keys only in prod.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard → Billing → Customer portal → save configuration → copy id (bpc_…)
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
# Checkout/settlement currency (centralised; default eur).
STRIPE_DEFAULT_CURRENCY=eur
# Stripe account country (Paradox FZCO → AE).
STRIPE_ACCOUNT_COUNTRY=AE
# Up to 22 chars shown on the customer's bank statement.
STRIPE_STATEMENT_DESCRIPTOR=DAR TAHARA
# Set to "true" to enable Stripe Tax automatic calculation (requires Tax setup).
STRIPE_TAX_ENABLED=false

# Email
RESEND_API_KEY=
MAILING_FROM_EMAIL=Dar Tahara <hello@dartahara.com>

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
# Independent high-entropy secrets used for AES-GCM storage and HMAC lookups.
WHATSAPP_DATA_ENCRYPTION_KEY=
WHATSAPP_PHONE_HASH_SECRET=
WHATSAPP_JOB_SECRET=
WHATSAPP_MESSAGE_RETENTION_DAYS=90
WHATSAPP_AUDIT_RETENTION_DAYS=365
WHATSAPP_RATE_LIMIT_PER_MINUTE=12
WHATSAPP_MAX_MESSAGE_LENGTH=3000
WHATSAPP_MAX_CONTEXT_MESSAGES=12
# Backwards-compatible aliases; prefer META_APP_SECRET / WHATSAPP_API_VERSION.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=
WHATSAPP_TEMPLATE_REVISED_QUOTE=
WHATSAPP_TEMPLATE_SUBSCRIPTION_ACTIVATED=
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=
WHATSAPP_TEMPLATE_ASSESSMENT_COMPLETED=
WHATSAPP_TEMPLATE_FAILED_PAYMENT=
WHATSAPP_TEMPLATE_HUMAN_FOLLOWUP=
WHATSAPP_TEMPLATE_ANNUAL_RENEWAL=

# Shared assistant / AI provider abstraction
# Leave unset to use the deterministic grounded-answer fallback only.
ASSISTANT_PROVIDER=
ASSISTANT_API_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_FALLBACK_MODEL=
ASSISTANT_TIMEOUT_MS=8000
ASSISTANT_MAX_TOKENS=450
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_RETRIEVAL_LIMIT=4
ASSISTANT_CONFIDENCE_THRESHOLD=0.62
ASSISTANT_KNOWLEDGE_HIGH_CONFIDENCE_SCORE=5
ASSISTANT_WEBSITE_MATCH_THRESHOLD=0.18
ASSISTANT_WEBSITE_SITEMAP_URL=https://www.dartahara.com/sitemap.xml
ASSISTANT_KNOWLEDGE_GAP_RETENTION_DAYS=365
ASSISTANT_PROVIDER_EVENT_RETENTION_DAYS=90
ASSISTANT_JOB_SECRET=
# Vercel Cron automatically sends this value as an Authorization bearer token.
CRON_SECRET=
PAUSE_REQUEST_JOB_SECRET=
BILLING_COLLECTION_JOB_SECRET=

# Optional semantic embeddings. Without these values the website knowledge
# engine remains operational with indexed full-text search.
ASSISTANT_EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
ASSISTANT_EMBEDDING_API_KEY=
ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
ASSISTANT_EMBEDDING_TIMEOUT_MS=6000

# Groq (preferred AI provider; deterministic knowledge fallback remains active on failure)
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_MS=15000
GROQ_MAX_TOKENS=600

# Optional xAI Grok reasoning/final-answer provider. Disabled by default.
# Grok is server-side only and may reason over approved facts, never define
# Dar Tahara prices, policies, legal terms, cities, availability or promises.
GROK_ENABLED=false
GROK_API_KEY=
GROK_MODEL=
GROK_TIMEOUT_MS=6000
GROK_MAX_TOKENS=350
GROK_RATE_LIMIT_PER_MINUTE=20

# Optional Google Gemini provider (free tier via Google AI Studio), used as an
# alternative assistant provider and to phrase the Operations Center's AI
# insights (see AI_INSIGHTS_LLM_* below). Uses Gemini's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=10000
# gemini-flash-latest is a "thinking" model, so it spends a chunk of the token
# budget on internal reasoning before the visible answer, so this needs
# headroom well above the actual output size (a few short insight rewrites).
GEMINI_MAX_TOKENS=2000

# FreeScout API is preferred. If unavailable, configure the support mailbox and
# Resend values for idempotent email ingestion.
FREESCOUT_BASE_URL=
FREESCOUT_API_KEY=
FREESCOUT_MAILBOX_ID=
FREESCOUT_SUPPORT_EMAIL=
FREESCOUT_FROM_EMAIL=
FREESCOUT_DEFAULT_ASSIGNEE_ID=
FREESCOUT_DEFAULT_TAGS=

# HospitalitySupport customer portal (FreeScout-compatible API).
# The HOSPITALITY_SUPPORT_* names take precedence; FREESCOUT_* values above are
# reused as backwards-compatible fallbacks for base URL, API key and mailbox.
HOSPITALITY_SUPPORT_BASE_URL=
HOSPITALITY_SUPPORT_API_TOKEN=
HOSPITALITY_SUPPORT_MAILBOX_ID=
HOSPITALITY_SUPPORT_DEFAULT_ASSIGNEE_ID=
HOSPITALITY_SUPPORT_DEPARTMENT_NAME=Dar Tahara Support
HOSPITALITY_SUPPORT_WEBHOOK_SECRET=
HOSPITALITY_SUPPORT_SYNC_SECRET=
HOSPITALITY_SUPPORT_PORTAL_SOURCE=dar-tahara-customer-portal
HOSPITALITY_SUPPORT_TIMEOUT_MS=12000

# Optional Cloudflare Turnstile protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Maps Platform (address autocomplete, property map pin, Street View).
# Both are PUBLIC by design. The key ships to the browser, so its protection is
# HTTP-referrer + API restrictions in Google Cloud, not secrecy. Leave empty to
# disable Maps entirely: the form then falls back to manual address entry and
# still submits normally.
# Map ID is required by AdvancedMarkerElement (the non-deprecated marker API).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Analytics 4 (Consent Mode v2, loaded only after the visitor accepts).
# Analytics → Admin → Data Streams → your web stream → Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Mautic (marketing backend) ─────────────────────────────────────────────────
# Server-side API access for contact sync. Credentials are the dedicated dt-api
# user (NOT the admin). See deploy/mautic. Never expose these to the browser.
MAUTIC_BASE_URL=https://marketing.saasolution.es
MAUTIC_API_USERNAME=dt-api
MAUTIC_API_PASSWORD=
MAUTIC_API_TIMEOUT_MS=10000

# Public tracking script (mtc.js). Consent-gated: only loads after the visitor
# accepts analytics. Set ENABLED=true to switch it on in an environment.
NEXT_PUBLIC_MAUTIC_BASE_URL=https://marketing.saasolution.es
NEXT_PUBLIC_MAUTIC_TRACKING_ENABLED=false

# ── Early-access verification / anti-spam ──────────────────────────────────────
# Salt for hashing IPs in consent metadata and for verification-token flows.
EMAIL_VERIFICATION_SIGNING_SECRET=
RATE_LIMIT_SECRET=

# Optional detailed-onboarding recovery (never fires for a lead who only joined
# Early Access). Disabled until the database migration, consent wording, Mautic
# objects and cron have all been reviewed and deployed.
EARLY_ACCESS_ABANDONED_REMINDERS_ENABLED=false
EARLY_ACCESS_ABANDONMENT_MINUTES=45
EARLY_ACCESS_REMINDER_1_MINUTES=180
EARLY_ACCESS_REMINDER_2_MINUTES=1440
EARLY_ACCESS_RESUME_TOKEN_HOURS=168
EARLY_ACCESS_PARTIAL_RETENTION_DAYS=30
EARLY_ACCESS_JOB_SECRET=

# ── Cubbit DS3 (S3-compatible object storage) ──────────────────────────────────
# Archives generated invoice/statement PDFs and stores customer-facing
# uploads (support ticket attachments, pause-request attachments) off the
# app's own infra. Create a bucket + access key at https://console.cubbit.eu
# → Object storage → Buckets, and IAM → API keys.
CUBBIT_S3_ENDPOINT=https://s3.cubbit.eu
CUBBIT_S3_REGION=eu-west-1
CUBBIT_S3_BUCKET=
CUBBIT_S3_ACCESS_KEY_ID=
CUBBIT_S3_SECRET_ACCESS_KEY=
# Informational-only usage alert (cron: /api/jobs/cubbit-storage-usage). Cubbit
# has no native per-bucket quota, so this just emails CUBBIT_STORAGE_ALERT_EMAIL
# at 80/90/100% of the cap — nothing is ever blocked or deleted automatically.
# Defaults to 1 TB (1000000000000 bytes) if unset. Alerts are a no-op unless
# both this and RESEND_API_KEY/MAILING_FROM_EMAIL above are configured.
CUBBIT_STORAGE_ALERT_CAP_BYTES=1000000000000
CUBBIT_STORAGE_ALERT_EMAIL=
